+//! Bounds failed automatic upgrades across refreshes and process restarts.
+//! The lock is held through activation; the attempt is recorded before any Git
+//! work so process exit cannot turn a failed clone into an immediate retry.
+
+use super::ConfiguredGitMarketplace;
+use crate::PluginGitMode;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::fs;
+use std::fs::File;
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::Duration;
+use std::time::SystemTime;
+
+const RETRY_DELAY: Duration = Duration::from_secs(5 * 60);
+const MAX_AUTOMATIC_ATTEMPTS: u32 = 3;
+
+#[derive(Default, Deserialize, Serialize)]
+struct RetryState {
+    configuration: String,
+    attempts: u32,
+    retry_after: u64,
+}
+
+pub(super) struct UpgradeAttempt {
+    _lock: File,
+    state_path: PathBuf,
+    state: RetryState,
+}
+
+impl UpgradeAttempt {
+    pub(super) fn begin(
+        install_root: &Path,
+        marketplace: &ConfiguredGitMarketplace,
+        mode: PluginGitMode,
+    ) -> Result<Option<Self>, String> {
+        Self::begin_at(install_root, marketplace, mode, SystemTime::now())
+    }
+
+    fn begin_at(
+        install_root: &Path,
+        marketplace: &ConfiguredGitMarketplace,
+        mode: PluginGitMode,
+        now: SystemTime,
+    ) -> Result<Option<Self>, String> {
+        let state_root = install_root.join(".upgrade-state");
+        fs::create_dir_all(&state_root).map_err(state_error)?;
+        // Hash names as well as configurations: no URLs or platform-sensitive
+        // marketplace names appear in the state file names or contents.
+        let key = format!(
+            "{}-{:x}",
+            std::env::consts::OS,
+            Sha256::digest(marketplace.name.as_bytes())
+        );
+        let lock = File::options()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(state_root.join(format!("{key}.lock")))
+            .map_err(state_error)?;
+        match lock.try_lock() {
+            Ok(()) => {}
+            Err(fs::TryLockError::WouldBlock) if mode == PluginGitMode::Automatic => {
+                return Ok(None);
+            }
+            Err(fs::TryLockError::WouldBlock) => {
+                return Err("another upgrade of this marketplace is in progress".to_string());
+            }
+            Err(fs::TryLockError::Error(err)) => return Err(state_error(err)),
+        }
+        let state_path = state_root.join(format!("{key}.json"));
+        let configuration = format!(
+            "{:x}",
+            Sha256::digest(
+                serde_json::to_vec(&(
+                    &marketplace.source,
+                    &marketplace.ref_name,
+                    &marketplace.sparse_paths,
+                ))
+                .map_err(state_error)?
+            )
+        );
+        let mut state = match fs::read(&state_path) {
+            Ok(contents) => match serde_json::from_slice::<RetryState>(&contents) {
+                Ok(state) => state,
+                // An explicit upgrade is also the recovery path for damaged state.
+                Err(_) if mode == PluginGitMode::Manual => RetryState::default(),
+                Err(err) => return Err(state_error(err)),
+            },
+            Err(err) if err.kind() == io::ErrorKind::NotFound => RetryState::default(),
+            Err(err) => return Err(state_error(err)),
+        };
+        if state.configuration != configuration {
+            state = RetryState {
+                configuration,
+                ..RetryState::default()
+            };
+        }
+        if mode == PluginGitMode::Automatic {
+            if state.attempts >= MAX_AUTOMATIC_ATTEMPTS {
+                return Err(format!(
+                    "automatic marketplace upgrades paused after {MAX_AUTOMATIC_ATTEMPTS} unsuccessful attempts; run `codex plugin marketplace upgrade {}` to retry, or change its source configuration",
+                    marketplace.name
+                ));
+            }
+            // A corrected clock must not defer automatic work indefinitely.
+            // Re-arm one bounded delay rather than bypassing failure backoff.
+            if state.retry_after > seconds(now)?.saturating_add(RETRY_DELAY.as_secs() * 4) {
+                state.retry_after = retry_after(now, state.attempts)?;
+                save_state(&state_path, &state).map_err(state_error)?;
+            }
+            if seconds(now)? < state.retry_after {
+                return Ok(None);
+            }
+        }
+        state.attempts = state.attempts.saturating_add(1).min(MAX_AUTOMATIC_ATTEMPTS);
+        state.retry_after = retry_after(now, state.attempts)?;
+        let attempt = Self {
+            _lock: lock,
+            state_path,
+            state,
+        };
+        // Fail closed if the attempt cannot be recorded (including a full disk).
+        attempt.save().map_err(state_error)?;
+        Ok(Some(attempt))
+    }
+
+    pub(super) fn finish(mut self, succeeded: bool) -> Result<(), String> {
+        if succeeded {
+            self.state.attempts = 0;
+            self.state.retry_after = 0;
+        } else {
+            self.state.retry_after = retry_after(SystemTime::now(), self.state.attempts)?;
+        }
+        self.save().map_err(state_error)
+    }
+
+    fn save(&self) -> io::Result<()> {
+        save_state(&self.state_path, &self.state)
+    }
+}
+
+fn save_state(path: &Path, state: &RetryState) -> io::Result<()> {
+    let mut file = tempfile::NamedTempFile::new_in(path.parent().unwrap())?;
+    serde_json::to_writer(&mut file, state)?;
+    file.flush()?;
+    file.as_file().sync_all()?;
+    file.persist(path).map_err(|err| err.error)?;
+    Ok(())
+}
+
+fn seconds(now: SystemTime) -> Result<u64, String> {
+    now.duration_since(SystemTime::UNIX_EPOCH)
+        .map(|duration| duration.as_secs())
+        .map_err(state_error)
+}
+
+fn retry_after(now: SystemTime, attempts: u32) -> Result<u64, String> {
+    let delay = RETRY_DELAY.as_secs() * (1 << attempts.saturating_sub(1).min(2));
+    Ok(seconds(now)?.saturating_add(delay))
+}
+
+fn state_error(err: impl std::fmt::Display) -> String {
+    format!(
+        "failed to persist marketplace upgrade retry state: {err}; automatic upgrades require writable, valid retry state"
+    )
+}
+
