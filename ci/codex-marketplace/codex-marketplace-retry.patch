+use super::*;
+use anyhow::Result;
+use pretty_assertions::assert_eq;
+use std::io::BufRead;
+use std::io::Read;
+use std::process::Stdio;
+
+fn marketplace() -> ConfiguredGitMarketplace {
+    ConfiguredGitMarketplace {
+        name: "demo".to_string(),
+        source: "https://example.com/marketplace.git".to_string(),
+        ref_name: None,
+        sparse_paths: Vec::new(),
+    }
+}
+
+fn start(
+    root: &Path,
+    marketplace: &ConfiguredGitMarketplace,
+    now: SystemTime,
+) -> Option<UpgradeAttempt> {
+    UpgradeAttempt::begin_at(root, marketplace, PluginGitMode::Automatic, now).unwrap()
+}
+
+#[test]
+fn repeated_failures_back_off_and_stop_across_reopened_state() -> Result<()> {
+    let root = tempfile::tempdir()?;
+    let marketplace = marketplace();
+    let mut now = SystemTime::now();
+    for delay in [300, 600, 1200] {
+        let attempt = start(root.path(), &marketplace, now).unwrap();
+        // Dropping without finish models a process that exits during Git work.
+        drop(attempt);
+        if delay != 1200 {
+            assert!(
+                start(
+                    root.path(),
+                    &marketplace,
+                    now + Duration::from_secs(delay - 1)
+                )
+                .is_none()
+            );
+        }
+        now += Duration::from_secs(delay);
+    }
+    let result = UpgradeAttempt::begin_at(
+        root.path(),
+        &marketplace,
+        PluginGitMode::Automatic,
+        now + Duration::from_secs(86400),
+    );
+    assert!(
+        matches!(result, Err(message) if message.contains("paused after 3 unsuccessful attempts"))
+    );
+    Ok(())
+}
+
+#[test]
+fn manual_upgrade_bypasses_pause_and_success_resets_failures() -> Result<()> {
+    let root = tempfile::tempdir()?;
+    let marketplace = marketplace();
+    for _ in 0..4 {
+        UpgradeAttempt::begin(root.path(), &marketplace, PluginGitMode::Manual)
+            .unwrap()
+            .unwrap()
+            .finish(false)
+            .unwrap();
+    }
+    assert!(UpgradeAttempt::begin(root.path(), &marketplace, PluginGitMode::Automatic).is_err());
+    UpgradeAttempt::begin(root.path(), &marketplace, PluginGitMode::Manual)
+        .unwrap()
+        .unwrap()
+        .finish(true)
+        .unwrap();
+    let next = start(root.path(), &marketplace, SystemTime::now()).unwrap();
+    assert_eq!(next.state.attempts, 1);
+    Ok(())
+}
+
+#[test]
+fn configuration_changes_reset_only_the_affected_marketplace() -> Result<()> {
+    let root = tempfile::tempdir()?;
+    let mut marketplace = marketplace();
+    let now = SystemTime::now();
+    drop(start(root.path(), &marketplace, now).unwrap());
+    let mut other = marketplace.clone();
+    other.name = "other".to_string();
+    drop(start(root.path(), &other, now).unwrap());
+    marketplace.ref_name = Some("fixed".to_string());
+    drop(start(root.path(), &marketplace, now).unwrap());
+    assert!(start(root.path(), &other, now).is_none());
+    marketplace.source.push_str("/changed");
+    drop(start(root.path(), &marketplace, now).unwrap());
+    marketplace.sparse_paths.push("plugins".to_string());
+    drop(start(root.path(), &marketplace, now).unwrap());
+    Ok(())
+}
+
+#[test]
+fn failure_records_delay_from_completion() -> Result<()> {
+    let root = tempfile::tempdir()?;
+    let marketplace = marketplace();
+    let past = SystemTime::now() - Duration::from_secs(3600);
+    start(root.path(), &marketplace, past)
+        .unwrap()
+        .finish(false)
+        .unwrap();
+    assert!(start(root.path(), &marketplace, SystemTime::now()).is_none());
+    Ok(())
+}
+
+#[test]
+fn damaged_state_blocks_automatic_work_but_manual_upgrade_can_repair_it() -> Result<()> {
+    let root = tempfile::tempdir()?;
+    let marketplace = marketplace();
+    let attempt = start(root.path(), &marketplace, SystemTime::now()).unwrap();
+    let state_path = attempt.state_path.clone();
+    drop(attempt);
+    fs::write(&state_path, "truncated JSON")?;
+    assert!(UpgradeAttempt::begin(root.path(), &marketplace, PluginGitMode::Automatic).is_err());
+    UpgradeAttempt::begin(root.path(), &marketplace, PluginGitMode::Manual)
+        .unwrap()
+        .unwrap()
+        .finish(true)
+        .unwrap();
+    assert!(start(root.path(), &marketplace, SystemTime::now()).is_some());
+    Ok(())
+}
+
+#[test]
+fn unwritable_state_fails_before_an_attempt_is_returned() -> Result<()> {
+    let root = tempfile::tempdir()?;
+    fs::write(root.path().join(".upgrade-state"), "not a directory")?;
+    assert!(UpgradeAttempt::begin(root.path(), &marketplace(), PluginGitMode::Automatic).is_err());
+    Ok(())
+}
+
+#[test]
+fn clock_rollback_cannot_bypass_backoff() -> Result<()> {
+    let root = tempfile::tempdir()?;
+    let marketplace = marketplace();
+    let now = SystemTime::now();
+    drop(start(root.path(), &marketplace, now).unwrap());
+    assert!(start(root.path(), &marketplace, now - Duration::from_secs(3600)).is_none());
+    Ok(())
+}
+
+#[test]
+fn corrected_clock_rearms_only_one_bounded_delay() -> Result<()> {
+    let root = tempfile::tempdir()?;
+    let marketplace = marketplace();
+    let now = SystemTime::now();
+    drop(
+        start(
+            root.path(),
+            &marketplace,
+            now + Duration::from_secs(30 * 86400),
+        )
+        .unwrap(),
+    );
+    assert!(start(root.path(), &marketplace, now).is_none());
+    assert!(
+        start(
+            root.path(),
+            &marketplace,
+            now + RETRY_DELAY - Duration::from_secs(1)
+        )
+        .is_none()
+    );
+    let attempt = start(root.path(), &marketplace, now + RETRY_DELAY).unwrap();
+    assert_eq!(attempt.state.attempts, 2);
+    Ok(())
+}
+
+#[test]
+fn live_process_is_exclusive_and_abandoned_attempt_survives_exit() -> Result<()> {
+    const CHILD_ROOT: &str = "CODEX_MARKETPLACE_RETRY_CHILD_ROOT";
+    if let Some(root) = std::env::var_os(CHILD_ROOT) {
+        let _attempt =
+            UpgradeAttempt::begin(Path::new(&root), &marketplace(), PluginGitMode::Automatic)
+                .unwrap()
+                .unwrap();
+        println!("retry-ready");
+        std::io::stdout().flush()?;
+        std::io::stdin().read_exact(&mut [0])?;
+        std::process::exit(0);
+    }
+    let root = tempfile::tempdir()?;
+    let mut child = codex_utils_process::background_command(std::env::current_exe()?)
+        .args(["--exact", "marketplace_upgrade::retry::tests::live_process_is_exclusive_and_abandoned_attempt_survives_exit", "--nocapture"])
+        .env(CHILD_ROOT, root.path())
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).spawn()?;
+    let stdout = std::io::BufReader::new(child.stdout.take().unwrap());
+    let mut ready = false;
+    for line in stdout.lines() {
+        if line?.contains("retry-ready") {
+            ready = true;
+            break;
+        }
+    }
+    assert!(ready);
+    assert!(start(root.path(), &marketplace(), SystemTime::now()).is_none());
+    assert!(
+        matches!(UpgradeAttempt::begin(root.path(), &marketplace(), PluginGitMode::Manual), Err(message) if message.contains("in progress"))
+    );
+    child.stdin.take().unwrap().write_all(b"x")?;
+    assert!(child.wait()?.success());
+    assert!(start(root.path(), &marketplace(), SystemTime::now()).is_none());
+    assert!(
+        start(
+            root.path(),
+            &marketplace(),
+            SystemTime::now() + RETRY_DELAY + Duration::from_secs(1)
+        )
+        .is_some()
+    );
+    Ok(())
+}
